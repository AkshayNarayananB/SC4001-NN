#!/bin/bash
#PBS -N make-degraded
#PBS -P personal-c230202
#PBS -q normal
#PBS -l select=1:ncpus=16:mem=32gb
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o /scratch/users/ntu/c230202/logs/make_degraded.log

cd $PBS_O_WORKDIR
module load miniforge3/25.3.1
eval "$(conda shell.bash hook)"
conda activate $HOME/envs/vcd
export VCD_DATA_ROOT=/scratch/users/ntu/c230202/data

python -m scripts.make_degraded --workers 16
python -m scripts.contact_sheet --n 4 --out results/contact_sheet.png
