#!/bin/bash
# Restore the degraded POPE images with a trained DAE (Phase 2, fix B).
#   qsub -v DAE=dae_v1 scripts/pbs/make_restored.pbs
#PBS -N make-restored
#PBS -P personal-c230202
#PBS -q normal
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=00:45:00
#PBS -j oe
#PBS -o /scratch/users/ntu/c230202/logs/make_restored.log

cd $PBS_O_WORKDIR
module load miniforge3/25.3.1
eval "$(conda shell.bash hook)"
conda activate $HOME/envs/vcd

export VCD_DATA_ROOT=/scratch/users/ntu/c230202/data
export VCD_CHECKPOINT_ROOT=/scratch/users/ntu/c230202/checkpoints

python -m scripts.make_restored --dae "${DAE:-dae_v1}"
