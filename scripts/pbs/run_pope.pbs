#!/bin/bash
# Submit via scripts/submit.sh, which sets -N, -o and CONFIG per job.
#PBS -P personal-c230202
#PBS -q normal
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb
#PBS -l walltime=01:30:00
#PBS -j oe

cd $PBS_O_WORKDIR
module load miniforge3/25.3.1
eval "$(conda shell.bash hook)"
conda activate $HOME/envs/vcd

export VCD_DATA_ROOT=/scratch/users/ntu/c230202/data
export VCD_OUTPUT_ROOT=/scratch/users/ntu/c230202/results/raw
export HF_HOME=/scratch/users/ntu/c230202/hf_cache
export HF_HUB_OFFLINE=1

nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
# CONFIG is a config file, or a directory whose configs run in one process (model loaded once)
if [ -d "$CONFIG" ]; then CONFIGS=("${CONFIG%/}"/*.yaml); else CONFIGS=("$CONFIG"); fi
python -m scripts.run_pope --config "${CONFIGS[@]}"
