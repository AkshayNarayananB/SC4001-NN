#!/bin/bash
# One sub-job per condition: run_readout for MODEL on POPE_SET (21 conditions -> -J 0-20).
#   qsub -J 0-20 -v MODEL=llava-1.5-7b,POPE_SET=pope_fresh,EXTRA=--vcd scripts/journal/aspire/readout_array.pbs
#PBS -N jreadout
#PBS -P personal-akshayna
#PBS -q normal
#PBS -l select=1:ncpus=16:ngpus=1:mem=64gb
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -o /scratch/users/ntu/akshayna/logs/
cd $PBS_O_WORKDIR
module load miniforge3/25.3.1
eval "$(conda shell.bash hook)"
conda activate $HOME/envs/vcdj
export HF_HOME=/scratch/users/ntu/akshayna/hf_cache HF_HUB_OFFLINE=1
export VCD_DATA_ROOT=/scratch/users/ntu/akshayna/data VCD_OUTPUT_ROOT=/scratch/users/ntu/akshayna/results/raw
export VCD_CHECKPOINT_ROOT=/scratch/users/ntu/akshayna/checkpoints POPE_SET MODEL
COND=$(python -c "from scripts.journal.run_readout import all_conditions as a; print(a()[$PBS_ARRAY_INDEX])")
echo "model=$MODEL set=$POPE_SET cond=$COND extra=$EXTRA host=$(hostname) gpu=$(nvidia-smi --query-gpu=name --format=csv,noheader)"
python -m scripts.journal.run_readout --model $MODEL --conditions $COND $EXTRA
