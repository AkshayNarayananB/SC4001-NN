#!/bin/bash
# Null-branch logits for every POPE question, one array task per condition (0..8 = clean,
# blur s1-4, noise s1-4). Run from the repo root on ASPIRE:
#   qsub model_fix_2/run_nulls.pbs                              # full grid, 9 tasks
#   qsub -J 4-8:4 -v LIMIT=30 model_fix_2/run_nulls.pbs         # smoke: blur s4 + noise s4, 30 q/split
# (-J 4-8:4 = tasks 4 and 8 only.)
#PBS -N fix2-nulls
#PBS -P personal-c230202
#PBS -q normal
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb
#PBS -l walltime=01:30:00
#PBS -J 0-8
#PBS -j oe
#PBS -o /scratch/users/ntu/c230202/logs/

cd $PBS_O_WORKDIR
module load miniforge3/25.3.1
eval "$(conda shell.bash hook)"
conda activate $HOME/envs/vcd

export VCD_DATA_ROOT=/scratch/users/ntu/c230202/data
export VCD_OUTPUT_ROOT=/scratch/users/ntu/c230202/results/raw
export HF_HOME=/scratch/users/ntu/c230202/hf_cache
export HF_HUB_OFFLINE=1

nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
python -m model_fix_2.run_nulls --condition-index $PBS_ARRAY_INDEX ${LIMIT:+--limit $LIMIT}
